{
	"$schema": "https://www.schemastore.org/package",
	"name": "@dynamoi/mcp",
	"version": "1.0.1",
	"packageManager": "bun@1.4.3",
	"mcpName": "io.github.getDynamoi/dynamoi",
	"type": "module",
	"license": "MIT",
	"description": "Music marketing for AI agents: free Smart Links, promotion campaigns, analytics, and distribution.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"music-promotion",
		"youtube-growth",
		"spotify-marketing",
		"meta-ads",
		"google-ads",
		"campaign-management",
		"record-label-tools",
		"artist-marketing",
		"ad-automation",
		"youtube-ads",
		"music-advertising",
		"music-distribution",
		"spotify-streams",
		"facebook-ads",
		"instagram-ads"
	],
	"homepage": "https://dynamoi.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getDynamoi/mcp.git"
	},
	"bugs": {
		"url": "https://github.com/getDynamoi/mcp/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"CAPABILITY_PARITY.md",
		"dist",
		"server.json",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/auth/protected-resource.d.ts",
			"import": "./dist/auth/protected-resource.js",
			"default": "./dist/auth/protected-resource.js"
		},
		"./consent": {
			"types": "./dist/consent.d.ts",
			"import": "./dist/consent.js",
			"default": "./dist/consent.js"
		},
		"./youtube-metrics": {
			"types": "./dist/youtube-metrics.d.ts",
			"import": "./dist/youtube-metrics.js",
			"default": "./dist/youtube-metrics.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun scripts/build.cjs",
		"dev": "bun scripts/build.cjs --watch",
		"typecheck": "bun ../../scripts/validate/with-heavy-slot.ts --class typecheck --wait-timeout-minutes 60 -- tsc --noEmit -p tsconfig.json",
		"registry:validate": "bun scripts/registry-contract.ts local",
		"registry:wait:npm": "bun scripts/registry-contract.ts npm --attempts 24 --delay-ms 5000",
		"registry:wait:official": "bun scripts/registry-contract.ts registry --attempts 24 --delay-ms 5000",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.1.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"@modelcontextprotocol/client": "2.1.0",
		"@modelcontextprotocol/ext-apps": "2.0.3",
		"@types/node": "25.6.0",
		"typescript": "7.0.2"
	}
}
