{
	"$schema": "https://www.schemastore.org/package",
	"name": "@dynamoi/mcp",
	"version": "1.0.7",
	"packageManager": "bun@1.4.3",
	"mcpName": "io.github.getDynamoi/dynamoi",
	"workspaces": [
		".",
		"cli"
	],
	"type": "module",
	"license": "MIT",
	"description": "Music promotion and distribution for AI agents: Spotify and YouTube ads, Smart Links, releases.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"music-promotion",
		"youtube-growth",
		"spotify-marketing",
		"meta-ads",
		"google-ads",
		"campaign-management",
		"record-label-tools",
		"artist-marketing",
		"ad-automation",
		"youtube-ads",
		"music-advertising",
		"music-distribution",
		"spotify-streams",
		"facebook-ads",
		"instagram-ads"
	],
	"homepage": "https://dynamoi.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getDynamoi/dynamoi.git"
	},
	"bugs": {
		"url": "https://github.com/getDynamoi/dynamoi/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"CAPABILITY_PARITY.md",
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"dist/auth/protected-resource.d.ts",
		"dist/auth/protected-resource.js",
		"dist/consent.d.ts",
		"dist/consent.js",
		"dist/flow-types.d.ts",
		"dist/index.d.ts",
		"dist/index.js",
		"dist/readiness-types.d.ts",
		"dist/server/about.d.ts",
		"dist/server/account-schema.generated.d.ts",
		"dist/server/channel-results-schema.d.ts",
		"dist/server/create-server.d.ts",
		"dist/server/distribution-tools.d.ts",
		"dist/server/messaging.d.ts",
		"dist/server/openai-tools.d.ts",
		"dist/server/output-schemas.d.ts",
		"dist/server/shop-tools.d.ts",
		"dist/server/smart-link-tools.d.ts",
		"dist/server/support-tools.d.ts",
		"dist/server/tools.d.ts",
		"dist/server/workflow-tools.d.ts",
		"dist/server/workspace/data.d.ts",
		"dist/server/workspace/tool.d.ts",
		"dist/server/youtube-channel-data-schema.d.ts",
		"dist/server/youtube-strategy-guide.d.ts",
		"dist/transport/http.d.ts",
		"dist/types.d.ts",
		"dist/version.d.ts",
		"dist/youtube-metrics.d.ts",
		"dist/youtube-metrics.js",
		"server.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/auth/protected-resource.d.ts",
			"import": "./dist/auth/protected-resource.js",
			"default": "./dist/auth/protected-resource.js"
		},
		"./consent": {
			"types": "./dist/consent.d.ts",
			"import": "./dist/consent.js",
			"default": "./dist/consent.js"
		},
		"./youtube-metrics": {
			"types": "./dist/youtube-metrics.d.ts",
			"import": "./dist/youtube-metrics.js",
			"default": "./dist/youtube-metrics.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun scripts/build.cjs",
		"dev": "bun scripts/build.cjs --watch",
		"typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p cli/tsconfig.json",
		"registry:validate": "bun scripts/registry-contract.ts local",
		"registry:wait:npm": "bun scripts/registry-contract.ts npm --attempts 24 --delay-ms 5000",
		"registry:wait:official": "bun scripts/registry-contract.ts registry --attempts 24 --delay-ms 5000",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish",
		"prepack": "bun scripts/build.cjs"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.0",
		"@modelcontextprotocol/client": "2.3.0",
		"@modelcontextprotocol/ext-apps": "2.0.3",
		"@types/node": "25.6.0",
		"typescript": "7.0.2",
		"typescript-6-compat": "npm:typescript@6.0.3"
	}
}
