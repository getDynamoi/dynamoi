{
	"$schema": "https://turborepo.dev/schema.v2.json",
	"extends": ["//"],
	"tasks": {
		"typecheck": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"build": {
			"outputs": ["dist/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"src/**",
				"package.json",
				"tsconfig.json",
				"scripts/build.cjs",
				"scripts/build-workspace.cjs",
				"server.json"
			],
			"description": "Build @dynamoi/mcp for workspace consumers"
		}
	}
}
